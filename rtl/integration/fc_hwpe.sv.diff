+  ) i_axi_dma (
+    .clk_i          ( clk_i              ),
+    .rst_ni         ( rst_ni             ),
+    .start_i        ( axi_dma_start      ),
+    .src_addr_i     ( ddr_addr_q         ),
+    .num_words_i    ( tile_len_q          ),
+    .done_o         ( axi_dma_done       ),
+    .buf_ready_o    ( axi_dma_buf_ready  ),
+    .dbg_state_o    ( axi_dma_dbg_state  ),
+    .rd_addr_i      ( sa_bram_rd_addr    ),  // systolic array drives BRAM read (global beat idx)
+    .rd_data_o      ( sa_act_data        ),  // 256-bit (Mode A single-bank)
+    .rd_data_wide_o ( sa_act_data_wide   ),  // 1024-bit (Mode B all-bank parallel)
+    // AXI AR (internal signals, muxed at top with im2col AR)
+    .axi_ar_addr_o  ( dma_axi_ar_addr     ),
+    .axi_ar_len_o   ( dma_axi_ar_len      ),
+    .axi_ar_size_o  ( dma_axi_ar_size     ),
+    .axi_ar_burst_o ( dma_axi_ar_burst    ),
+    .axi_ar_valid_o ( dma_axi_ar_valid    ),
+    .axi_ar_ready_i ( dma_axi_ar_ready    ),
+    .axi_ar_lock_o  (                     ),
+    .axi_ar_cache_o (                     ),
+    .axi_ar_prot_o  (                     ),
+    .axi_ar_qos_o   (                     ),
+    .axi_ar_id_o    (                     ),
+    // AXI R (shared read data, but only accepted during S_DMA_LOAD)
+    .axi_r_data_i   ( hwpe_axi_r_data_i   ),
+    .axi_r_resp_i   ( hwpe_axi_r_resp_i   ),
+    .axi_r_last_i   ( hwpe_axi_r_last_i   ),
+    .axi_r_valid_i  ( is_dma ? hwpe_axi_r_valid_i : 1'b0 ),
+    .axi_r_ready_o  ( dma_axi_r_ready     ),
+    .axi_r_id_i     ( 1'b0                ),
+    // AXI AW/W/B — disconnected (im2col module drives these instead)
+    .axi_aw_addr_o  (                     ),
+    .axi_aw_len_o   (                     ),
+    .axi_aw_size_o  (                     ),
+    .axi_aw_burst_o (                     ),
+    .axi_aw_valid_o (                     ),
+    .axi_aw_ready_i ( 1'b0               ),
+    .axi_aw_lock_o  (                     ),
+    .axi_aw_cache_o (                     ),
+    .axi_aw_prot_o  (                     ),
+    .axi_aw_qos_o   (                     ),
+    .axi_aw_id_o    (                     ),
+    .axi_w_data_o   (                     ),
+    .axi_w_strb_o   (                     ),
+    .axi_w_last_o   (                     ),
+    .axi_w_valid_o  (                     ),
+    .axi_w_ready_i  ( 1'b0               ),
+    .axi_b_resp_i   ( 2'b0               ),
+    .axi_b_valid_i  ( 1'b0               ),
+    .axi_b_ready_o  (                     )
+  );
+
+  // ── HW im2col engine (DDR3 AXI read → DDR3 AXI write) ───────────────
+  hwpe_im2col #(
+    .AXI_ADDR_WIDTH ( 32  ),
+    .AXI_DATA_WIDTH ( 256 )
+  ) i_im2col (
+    .clk_i            ( clk_i              ),
+    .rst_ni           ( rst_ni             ),
+    .start_i          ( im2col_start       ),
+    .done_o           ( im2col_done        ),
+    // Configuration
+    .in_base_addr_i   ( im2col_addr_q      ),
+    .in_ch_stride_i   ( total_pix_q        ),
+    .in_ch_i          ( in_ch_q            ),
+    .img_w_i          ( im2col_img_w_q     ),
+    .img_h_i          ( im2col_img_h_q     ),
+    .ddr_dest_addr_i  ( ddr_addr_q         ),
+    .batch_start_i    ( im2col_bstart_q    ),
+    .batch_pix_i      ( batch_pix_q        ),
+    // AXI read (input from DDR3, muxed with DMA at top-level)
+    .axi_ar_addr_o    ( im2col_axi_ar_addr  ),
+    .axi_ar_len_o     ( im2col_axi_ar_len   ),
+    .axi_ar_size_o    ( im2col_axi_ar_size  ),
+    .axi_ar_burst_o   ( im2col_axi_ar_burst ),
+    .axi_ar_valid_o   ( im2col_axi_ar_valid ),
+    .axi_ar_ready_i   ( im2col_axi_ar_ready ),
+    .axi_r_data_i     ( im2col_axi_r_data   ),
+    .axi_r_last_i     ( im2col_axi_r_last   ),
+    .axi_r_valid_i    ( im2col_axi_r_valid  ),
+    .axi_r_ready_o    ( im2col_axi_r_ready  ),
+    // AXI write (im2col matrix to DDR3, muxed with post_proc)
+    .axi_aw_addr_o    ( im2col_axi_aw_addr  ),
+    .axi_aw_len_o     ( im2col_axi_aw_len   ),
+    .axi_aw_size_o    ( im2col_axi_aw_size  ),
+    .axi_aw_burst_o   ( im2col_axi_aw_burst ),
+    .axi_aw_valid_o   ( im2col_axi_aw_valid ),
+    .axi_aw_ready_i   ( im2col_axi_aw_ready ),
+    .axi_w_data_o     ( im2col_axi_w_data   ),
+    .axi_w_strb_o     ( im2col_axi_w_strb   ),
+    .axi_w_last_o     ( im2col_axi_w_last   ),
+    .axi_w_valid_o    ( im2col_axi_w_valid  ),
+    .axi_w_ready_i    ( im2col_axi_w_ready  ),
+    .axi_b_resp_i     ( im2col_axi_b_resp   ),
+    .axi_b_valid_i    ( im2col_axi_b_valid  ),
+    .axi_b_ready_o    ( im2col_axi_b_ready  )
+  );
+
+  // ─────────────────────────────────────────────────────────────────────
+  // AXI top-level mux: share single AXI master between consumers
+  // ─────────────────────────────────────────────────────────────────────
+  //  AR (read): im2col (S_IM2COL) vs DMA (S_DMA_LOAD)
+  //  AW/W/B (write): im2col (S_IM2COL) vs post_proc (S_RUN)
+  //
+  // DMA AR/R signals (internal, wired from hwpe_axi_dma instance)
+  logic [31:0] dma_axi_ar_addr;
+  logic [7:0]  dma_axi_ar_len;
+  logic [2:0]  dma_axi_ar_size;
+  logic [1:0]  dma_axi_ar_burst;
+  logic        dma_axi_ar_valid;
+  logic        dma_axi_ar_ready;
+  logic        dma_axi_r_ready;
+
+  // --- AR mux ---
+  assign hwpe_axi_ar_addr_o  = is_dma ? dma_axi_ar_addr  : im2col_axi_ar_addr;
+  assign hwpe_axi_ar_len_o   = is_dma ? dma_axi_ar_len   : im2col_axi_ar_len;
+  assign hwpe_axi_ar_size_o  = is_dma ? dma_axi_ar_size  : im2col_axi_ar_size;
+  assign hwpe_axi_ar_burst_o = is_dma ? dma_axi_ar_burst : im2col_axi_ar_burst;
+  assign hwpe_axi_ar_valid_o = is_dma ? dma_axi_ar_valid : im2col_axi_ar_valid;
+  assign dma_axi_ar_ready    = is_dma ? hwpe_axi_ar_ready_i : 1'b0;
+  assign im2col_axi_ar_ready = is_dma ? 1'b0              : hwpe_axi_ar_ready_i;
+
+  // --- R demux ---
+  assign im2col_axi_r_data   = hwpe_axi_r_data_i;
+  assign im2col_axi_r_last   = hwpe_axi_r_last_i;
+  assign im2col_axi_r_valid  = is_dma ? 1'b0 : hwpe_axi_r_valid_i;
+  // DMA R path is handled directly in hwpe_axi_dma instance via hwpe_axi_r_* ports
+  //   (see instance wiring above). r_ready routed below.
+  assign hwpe_axi_r_ready_o  = is_dma ? dma_axi_r_ready : im2col_axi_r_ready;
+
+  // --- AW/W/B mux: im2col (S_IM2COL) vs post_proc (S_RUN) ---
+  logic is_run;
+  assign is_run = (top_q == S_RUN);
+
+  assign hwpe_axi_aw_addr_o  = is_run ? pp_axi_aw_addr  : im2col_axi_aw_addr;
+  assign hwpe_axi_aw_len_o   = is_run ? pp_axi_aw_len   : im2col_axi_aw_len;
+  assign hwpe_axi_aw_size_o  = is_run ? pp_axi_aw_size  : im2col_axi_aw_size;
+  assign hwpe_axi_aw_burst_o = is_run ? pp_axi_aw_burst : im2col_axi_aw_burst;
+  assign hwpe_axi_aw_valid_o = is_run ? pp_axi_aw_valid : im2col_axi_aw_valid;
+  assign pp_axi_aw_ready     = is_run ? hwpe_axi_aw_ready_i : 1'b0;
+  assign im2col_axi_aw_ready = is_run ? 1'b0              : hwpe_axi_aw_ready_i;
+
+  assign hwpe_axi_w_data_o   = is_run ? pp_axi_w_data   : im2col_axi_w_data;
+  assign hwpe_axi_w_strb_o   = is_run ? pp_axi_w_strb   : im2col_axi_w_strb;
+  assign hwpe_axi_w_last_o   = is_run ? pp_axi_w_last   : im2col_axi_w_last;
+  assign hwpe_axi_w_valid_o  = is_run ? pp_axi_w_valid  : im2col_axi_w_valid;
+  assign pp_axi_w_ready      = is_run ? hwpe_axi_w_ready_i : 1'b0;
+  assign im2col_axi_w_ready  = is_run ? 1'b0              : hwpe_axi_w_ready_i;
+
+  assign pp_axi_b_resp       = hwpe_axi_b_resp_i;
+  assign pp_axi_b_valid      = is_run ? hwpe_axi_b_valid_i : 1'b0;
+  assign im2col_axi_b_resp   = hwpe_axi_b_resp_i;
+  assign im2col_axi_b_valid  = is_run ? 1'b0              : hwpe_axi_b_valid_i;
+  assign hwpe_axi_b_ready_o  = is_run ? pp_axi_b_ready : im2col_axi_b_ready;
+
+endmodule
